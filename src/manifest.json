{
	"manifest_version": 1,
	"id": "com.madusanka.reuseSections",
	"app_min_version": "3.1.0",
	"app_min_version_mobile": "3.2.0",
	"platforms": [
		"desktop",
		"mobile"
	],
	"version": "1.0.0",
	"name": "Reuse Sections",
	"description": "Write a section once and reuse it anywhere: mark it with `&&&` ... `/&&&`, then embed it in any note with `&&&/notebook/note/#section`.",
	"author": "madusanka",
	"homepage_url": "https://github.com/madusankabibile/joplin-plugin-reuse-sections",
	"repository_url": "https://github.com/madusankabibile/joplin-plugin-reuse-sections",
	"keywords": [
		"transclusion",
		"embed",
		"include",
		"reuse",
		"section"
	],
	"categories": [
		"editor",
		"viewer",
		"productivity"
	],
	"icons": {
		"16": "images/icon16.png",
		"32": "images/icon32.png",
		"48": "images/icon48.png",
		"128": "images/icon128.png"
	},
	"promo_tile": {
		"src": "images/promo_tile.png",
		"label": "Reuse Sections - write a section once, embed it in any note"
	}
}
